# GEMINI_API_KEY: Required for server-side Gemini AI deduction calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional external Supabase storage.
# When omitted, SHERLOCK automatically uses its self-contained server storage with seeded data.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# GOOGLE_SAFE_BROWSING_KEY: Optional Google Safe Browsing v4 API key.
# When omitted, SHERLOCK checks its built-in reputation feed and open threat lists.
GOOGLE_SAFE_BROWSING_KEY=""

# CLIENT_HASH_SALT: Server-side salt for hashing client identifiers (privacy by default, no raw IPs stored).
CLIENT_HASH_SALT="sherlock-baker-street-221b-salt"

# VITE_GOOGLE_SITE_VERIFICATION: Optional Google Search Console HTML meta verification token.
VITE_GOOGLE_SITE_VERIFICATION=""

